<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cuinspace.keep-awake</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/cuinspace/Library/Scripts/keep-awake.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- keep-awake.sh 内部是死循环；进程退出后 Launchd 自动拉起 -->
    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/cuinspace/Library/Logs/keep-awake.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/cuinspace/Library/Logs/keep-awake.err</string>
</dict>
</plist>
</content>
</invoke>